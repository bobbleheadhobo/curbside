[Unit]
Description=deal_bot — one pass over every hunt that is due
Documentation=file:///home/joey/code/deal_bot/README.md
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/joey/code/deal_bot
ExecStart=/home/joey/code/deal_bot/.venv/bin/python -m dealbot.cli once --due
# A run is fetch (rate-limited, 15s between Facebook requests) plus scoring
# (subprocess per listing). Generous, but bounded: a wedged run must not still
# be holding the lock when the next tick fires.
TimeoutStartSec=1800
# Scoring outages, throttling and the spend ceiling are all recorded in the runs
# table and reported as a non-zero-value run, not as a unit failure. A real
# failure here means the process itself died.
Restart=no
